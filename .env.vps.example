# === Variables d'environnement pour le déploiement VPS ===
# Copie ce fichier en ".env" sur le serveur puis remplis les valeurs.
#   cp .env.vps.example .env

# --- Reverse proxy / domaine ---
# Sans domaine : laisse ":80" (accès en HTTP via http://IP_DU_VPS)
# Avec un domaine : mets ton domaine, ex. SITE_ADDRESS=maoretech.com
SITE_ADDRESS=:80

# --- Auth ---
# Génère : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET="change-me-32-chars-minimum"
# Sans domaine : http://IP_DU_VPS   |   Avec domaine : https://mondomaine.com
BACKEND_URL="http://IP_DU_VPS"

# --- Resend (envoi des codes OTP par email) ---
RESEND_API_KEY=""
RESEND_FROM=""
