# === Variables d'environnement pour le déploiement VPS ===
# Copie ce fichier en ".env" sur le serveur puis remplis les valeurs.
#   cp .env.vps.example .env

# Le reverse proxy est géré par le nginx du serveur (voir deploy/nginx-maoretech.conf),
# l'app écoute seulement en local sur 127.0.0.1:3000.

# --- Base de données (Neon / Postgres) ---
# Connection string Neon. Utilise la connexion DIRECTE (sans "-pooler" dans l'hôte)
# et garde ?sslmode=require. Ex :
# DATABASE_URL="postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/dbname?sslmode=require"
DATABASE_URL=""

# --- Auth ---
# Génère : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET="change-me-32-chars-minimum"
# Sans domaine : http://IP_DU_VPS   |   Avec domaine : https://mondomaine.com
BACKEND_URL="http://IP_DU_VPS"

# --- Resend (envoi des codes OTP par email) ---
RESEND_API_KEY=""
RESEND_FROM=""
