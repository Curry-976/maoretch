# --- Auth ---
# Génère avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET="change-me-32-chars-minimum"
# En prod sur Railway : https://<ton-app>.up.railway.app
BACKEND_URL="http://localhost:3000"

# --- Base de données SQLite ---
# Local : un fichier dans backend/prisma/
DATABASE_URL="file:./prisma/dev.db"
# En prod sur Railway (avec un volume monté sur /data) :
# DATABASE_URL="file:/data/maoretech.db"

# --- Resend (envoi des codes OTP) ---
# Clé sur https://resend.com (gratuit jusqu'à 3 000 emails/mois)
RESEND_API_KEY=""
# Par défaut : "MaoreTech <onboarding@resend.dev>" (utilisable sans vérifier un domaine)
RESEND_FROM=""

# --- Serveur ---
PORT="3000"
